{
  "name": "tviz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "test": "vitest run",
    "anonymize": "bun scripts/anonymize.ts",
    "infra:install": "cd infra && bun install --frozen-lockfile",
    "infra:typecheck": "cd infra && bun run typecheck",
    "plan": "cd infra && bun run plan:prod",
    "deploy": "cd infra && bun run deploy:prod",
    "bootstrap:ci": "infra/node_modules/.bin/alchemy deploy infra/stacks/github.ts --profile admin --yes"
  },
  "dependencies": {
    "effect": "^4.0.0-beta.107",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
